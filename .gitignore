# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================
.env
.env.local
.env.production
.env.staging
# Keep .env.example (it's safe — has no real secrets)
!.env.example


# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python


# ============================================================
# VIRTUAL ENVIRONMENT
# ============================================================
venv/
env/
ENV/
.venv/
.env/


# ============================================================
# DJANGO SPECIFIC
# ============================================================
# SQLite database file (has real user data — never commit)
*.sqlite3
db.sqlite3

# Django collected static files
staticfiles/
static_root/
/static/

# Django media uploads (user-uploaded files)
media/

# Django migrations (optional — some teams commit these)
# Uncomment below ONLY if your professor says to ignore migrations
# */migrations/*.py
# !*/migrations/__init__.py


# ============================================================
# TESTING & COVERAGE
# ============================================================
.coverage
coverage.xml
htmlcov/
.pytest_cache/
nosetests.xml
test-results/


# ============================================================
# IDEs & EDITORS
# ============================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#


# ============================================================
# OS GENERATED FILES
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ============================================================
# LOGS & TEMPORARY FILES
# ============================================================
*.log
logs/
*.tmp
*.temp
pip-log.txt
pip-delete-this-directory.txt


# ============================================================
# BUILD & DISTRIBUTION
# ============================================================
dist/
build/
*.egg-info/
.eggs/
*.egg
MANIFEST


# ============================================================
# JUPYTER NOTEBOOKS (if used for data exploration)
# ============================================================
.ipynb_checkpoints
*.ipynb


# ============================================================
# DOCKER (if you add Docker later)
# ============================================================
.dockerignore
docker-compose.override.yml